# =============================================================================
# Hermes Workspace OS — example environment configuration.
# Copy to the repo root as `.env` (`just env`) and adjust. NEVER commit `.env`.
# Milestone 1 uses only a subset; later milestones consume the rest.
# See docs/PROJECT_BIBLE/08_Development/Deployment.md.
# =============================================================================

# ---- General ----
HERMES_ENV=development            # development | production
LOG_LEVEL=info                    # debug | info | warning | error

# ---- API service ----
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed CORS origins (the web app in dev).
API_CORS_ORIGINS=http://localhost:3000

# ---- Web app ----
# Base URL the browser/SSR uses to reach the API.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- PostgreSQL (source of record) ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hermes
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=hermes
# Assembled DSN (used by the API/worker). Keep in sync with the values above.
DATABASE_URL=postgresql+psycopg://hermes:change-me-postgres@postgres:5432/hermes

# ---- Redis (cache, Celery broker/result, event bus) ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Neo4j (knowledge graph) — used from Milestone 8 ----
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-neo4j

# ---- Qdrant (vectors) — used from Milestone 6/7 ----
QDRANT_URL=http://qdrant:6333

# ---- Meilisearch (keyword search) — used from Milestone 7 ----
MEILI_URL=http://meilisearch:7700
MEILI_MASTER_KEY=change-me-meili-master-key

# ---- MinIO (object storage) — used from Milestone 6 ----
MINIO_ENDPOINT=http://minio:9000
MINIO_ROOT_USER=hermes
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=hermes

# ---- AI providers (pluggable) — used from Milestone 6/9 ----
# Decision Required (D1/D5): confirm defaults. Self-host-first favors local (Ollama).
AI_CHAT_PROVIDER=ollama           # openai | anthropic | gemini | ollama
AI_EMBEDDINGS_PROVIDER=ollama     # openai | anthropic | gemini | ollama
OLLAMA_URL=http://host.docker.internal:11434
# Provide keys only for the hosted providers you actually enable:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ---- Secrets / crypto — used from Milestone 3 ----
# Application secret key (sessions/signing). Generate a strong random value.
HERMES_SECRET_KEY=change-me-app-secret
# Key used to envelope-encrypt provider secrets at rest (see Security_Model.md).
HERMES_ENCRYPTION_KEY=change-me-encryption-key
