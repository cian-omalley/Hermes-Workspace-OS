{
  "name": "@hermes/ts-client",
  "version": "0.1.0",
  "private": true,
  "description": "Generated TypeScript client for the Hermes Workspace OS API (contract seam)",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "openapi-fetch": "0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.4.1",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  }
}
